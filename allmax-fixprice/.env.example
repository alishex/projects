PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# Leave empty to print a randomly generated first-run administrator password.
ADMIN_EMAIL=admin@allmaxfixprice.local
ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Turn off only after replacing sample products with your real stock.
DEMO_MODE=true
# If behind a trusted reverse proxy set this to true; never expose Node directly then.
TRUST_PROXY=false
# Production behind HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
